// Supabase (PostgreSQL). DATABASE_URL = pooler (6543, pgbouncer), DIRECT_URL = to'g'ridan-to'g'ri (5432, migratsiya uchun).
// Enum'lar o'rniga String ishlatilgan; qiymatlar Zod bilan tekshiriladi.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Department {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
  rooms Room[]
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String
  email        String   @unique
  passwordHash String
  role         String // ADMIN | RESPONSIBLE | EMPLOYEE
  isActive     Boolean  @default(true)
  departmentId Int?
  createdAt    DateTime @default(now())

  department Department?        @relation(fields: [departmentId], references: [id])
  equipment  Equipment[]
  history    EquipmentHistory[]
  repairs    Repair[]
}

model Room {
  id           Int    @id @default(autoincrement())
  name         String
  floor        Int    @default(1)
  departmentId Int?

  department Department? @relation(fields: [departmentId], references: [id])
  equipment  Equipment[]
}

model EquipmentType {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  icon      String      @default("box")
  equipment Equipment[]
}

model Equipment {
  id                  Int       @id @default(autoincrement())
  inventoryNumber     String    @unique
  name                String
  typeId              Int
  brand               String?
  model               String?
  serialNumber        String?
  purchaseDate        DateTime?
  price               Float?
  roomId              Int?
  responsibleUserId   Int?
  condition           String    @default("NEW") // NEW | GOOD | FAIR | BROKEN | WRITTEN_OFF
  usageStatus         String    @default("IN_STORAGE") // IN_USE | IN_STORAGE | IN_REPAIR | WRITTEN_OFF
  notes               String?
  isArchived          Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  type        EquipmentType      @relation(fields: [typeId], references: [id])
  room        Room?              @relation(fields: [roomId], references: [id])
  responsible User?              @relation(fields: [responsibleUserId], references: [id])
  repairs     Repair[]
  history     EquipmentHistory[]

  @@index([typeId])
  @@index([roomId])
  @@index([responsibleUserId])
}

model Repair {
  id           Int       @id @default(autoincrement())
  equipmentId  Int
  sentDate     DateTime
  reason       String
  repairer     String?
  cost         Float?
  returnedDate DateTime?
  result       String?
  createdById  Int?

  equipment Equipment @relation(fields: [equipmentId], references: [id])
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@index([equipmentId])
}

// Faqat qo'shiladi, o'zgartirilmaydi
model EquipmentHistory {
  id          Int      @id @default(autoincrement())
  equipmentId Int
  action      String
  field       String?
  oldValue    String?
  newValue    String?
  changedById Int?
  changedAt   DateTime @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id])
  changedBy User?     @relation(fields: [changedById], references: [id])

  @@index([equipmentId])
}

model InventoryCounter {
  year       Int @id
  lastNumber Int
}
