# Nusxa oling: cp .env.example .env  va qiymatlarni o'zgartiring
PORT=4000
# SQLite (standart, Docker kerak emas). PostgreSQL uchun: postgresql://USER:PASS@localhost:5432/inventrack
DATABASE_URL="file:./dev.db"
# Kamida 32 belgi, tasodifiy. Masalan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Faqat seed uchun (demo foydalanuvchilar paroli)
SEED_PASSWORD=Demo12345!
